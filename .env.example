# Storyworks Studio Backend Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=storyworks-super-secret-key-change-in-production-2026
PORT=5000
HOST=127.0.0.1
DEBUG=True

# Database Configuration: MongoDB Atlas
# Replace with your actual MongoDB Atlas cluster URI:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=story_works_db

# Admin Default Credentials
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@storyworks.studio
DEFAULT_ADMIN_PASSWORD=admin123

# Forgot Password OTP — Email (Gmail)
# SMTP_PASSWORD must be a Gmail App Password (Google Account -> Security -> App passwords), not your normal Gmail password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM_NAME=Storyworks Studio

# Forgot Password OTP — SMS (Fast2SMS: fast2sms.com -> Dev API -> API Key)
FAST2SMS_API_KEY=your-fast2sms-api-key
