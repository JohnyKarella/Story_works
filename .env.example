# Storyworks Studio Backend Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=storyworks-super-secret-key-change-in-production-2026
PORT=5000
HOST=127.0.0.1
DEBUG=True
# Database Configuration (SQLite by default, or MySQL)
DATABASE_TYPE=sqlite
DATABASE_PATH=storyworks.db
# Optional MySQL Configuration (if DATABASE_TYPE=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=storyworks_db
# Admin Default Credentials
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@storyworks.studio
DEFAULT_ADMIN_PASSWORD=admin123
